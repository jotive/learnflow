DATABASE_URL=postgresql+psycopg://learnflow:learnflow@db:5432/learnflow
JWT_SECRET=change-me-to-at-least-32-bytes
JWT_EXPIRES_MINUTES=60
API_PREFIX=/api/v1

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

RESEND_ENDPOINT=https://api.resend.com/emails

LOG_LEVEL=INFO
LOG_JSON=false
LOG_FILE=
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
